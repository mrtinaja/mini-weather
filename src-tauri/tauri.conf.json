{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mini Weather",
  "version": "0.1.0",
  "identifier": "com.local.miniweather",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mini Weather",
        "width": 980,
        "height": 820,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 560,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-component-update --disk-cache-size=52428800"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}